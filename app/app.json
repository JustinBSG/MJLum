{
  "expo": {
    "name": "麻雀諗",
    "slug": "mjlum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mjlum",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.justinbsg.mjlum",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh-Hant-HK",
        "CFBundleLocalizations": [
          "zh-Hant-HK"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.justinbsg.mjlum",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "zh-Hant-HK"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "release": 1,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "930fdbd5-d9e8-4cc2-8340-74718a08ace2"
      }
    }
  }
}
